#!/bin/sh
set -e
case "$1" in
    purge|remove)
        echo "Отключение службы..."
        systemctl stop vlab-webpanel.service || true
        systemctl disable vlab-webpanel.service || true
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm вызван с неизвестным аргументом: \$1" >&2
        exit 1
        ;;
esac

exit 0
