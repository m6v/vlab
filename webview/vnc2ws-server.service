[Unit]
Description=vnc2ws-server: Web Console Server & API Manager
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/qemu
ExecStart=/srv/qemu/vnc2ws-server.py 0.0.0.0:8081 --proxy-port=8080 --config-dir=/srv/qemu/config --novncroot=/usr/share/novnc/
KillMode=process
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vnc2ws-server

[Install]
WantedBy=multi-user.target
