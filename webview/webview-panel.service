[Unit]
Description=Instructor's Web Panel
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/qemu
ExecStart=/srv/qemu/webview-panel.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webview-panel
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
