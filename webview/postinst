#!/bin/sh
set -e

SERVER_NAME=vnc2ws-server
PANEL_NAME=vnc2ws-webpanel

case "$1" in
    configure)
        echo "Настройка служб $SERVER_NAME и $PANEL_NAME..."
        systemctl daemon-reload
        systemctl enable $SERVER_NAME.service $PANEL_NAME.service
        systemctl restart $SERVER_NAME.service $PANEL_NAME.service
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        # Код выполняемый в случае, если установка прервалась или произошел откат
        ;;

    *)
        echo "postinst вызван с неизвестным аргументом: \$1" >&2
        exit 1
        ;;
esac

exit 0
