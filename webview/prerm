#!/bin/sh
set -e

SERVER_NAME=vnc2ws-server
PANEL_NAME=vnc2ws-webpanel

case "$1" in
    purge|remove)
        echo "Отключение службы $SERVER_NAME и $PANEL_NAME..."
        systemctl stop $SERVER_NAME.service $PANEL_NAME.service
        systemctl disable $SERVER_NAME.service $PANEL_NAME.service
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm вызван с неизвестным аргументом: \$1" >&2
        exit 1
        ;;
esac

exit 0
