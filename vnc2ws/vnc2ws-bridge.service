[Unit]
Description=vnc2ws-bridge: VNC to WebSocket Gateway Proxy
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/qemu
ExecStart=/srv/qemu/vnc2ws-bridge.py 0.0.0.0:8080 --config-dir=/srv/qemu/config
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vnc2ws-bridge

[Install]
WantedBy=multi-user.target
