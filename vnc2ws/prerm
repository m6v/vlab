#!/bin/sh
set -e

BRIDGE_NAME=vnc2ws-bridge

case "$1" in
    purge|remove)
        echo "Отключение служб..."
        systemctl stop $BRIDGE_NAME.service
        systemctl disable $BRIDGE_NAME.service
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm вызван с неизвестным аргументом: \$1" >&2
        exit 1
        ;;
esac

exit 0
