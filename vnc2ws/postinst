#!/bin/sh
set -e

BRIDGE_NAME=vnc2ws-bridge

case "$1" in
    configure)
        echo "Настройка служб веб-доступа к рабочим столам виртуальных машин ..."
        systemctl daemon-reload
        systemctl enable --now $BRIDGE_NAME.service
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        # Код выполняемый в случае, если установка прервалась или произошел откат
        ;;

    *)
        echo "postinst вызван с неизвестным аргументом: \$1" >&2
        exit 1
        ;;
esac

exit 0
