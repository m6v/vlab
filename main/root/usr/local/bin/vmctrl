#!/bin/bash

CONFIG_DIR="/srv/qemu/config"
LOG_FILE="/srv/qemu/vmctrl.log"

echo "$(date '+%Y-%m-%d %H:%M:%S') $0 $*" >> $LOG_FILE

ACTION="$1"

# Если действие не list, инициализируем и жестко проверяем параметры ВМ
if [ "$ACTION" != "list" ]; then
    # Проверка наличия аргумента с именем машины
    if [ -z "$2" ]; then
        echo "Ошибка: Не указано имя виртуальной машины." >&2
        echo "Использование: $0 <list|info|start|stop|pause|resume|kill> <имя_машины> или $0 list" >&2
        exit 1
    fi

    export VM_NAME="$2"
    CONF_FILE="${CONFIG_DIR}/${VM_NAME}.conf"

    # Проверка наличия файла конфигурации
    if [ ! -f "$CONF_FILE" ]; then
        echo "Ошибка: Файл конфигурации для '${VM_NAME}' не найден." >&2
        exit 1
    fi

    # Определение имени пользователя на рабочем месте (seat0)
    USER=$(loginctl list-sessions --no-legend | grep 'seat0' | awk '{print $3}')

    # Если переменная пустая (сессия не найдена или пользователь root), аварийный вызод
    if [ -z "$USER" ] || [ "$USER" = "root" ]; then
        echo "Ошибка: Активный локальный пользователь на seat0 не найден. Запуск прерван." >&2
        exit 1
    fi

    export HOME=/home/$USER

    # Подготовка аргументов для qemu-system на основе конфигурационного файла
    VM_PARMS=$(envsubst '$HOME,$VM_NAME' < "$CONF_FILE")

    # Определение номера порта с учетом базы 5900 и номера дисплея
    VNC_ADDR="127.0.0.1:$((5900 + $(echo "$VM_PARMS" | grep -Po '(?<=-vnc 0.0.0.0:)[0-9]+' || echo 0)))"

    # Поиск подстроки -spice и взятие всего до ближайшего дефиса в круглые скобки
    if [[ "$VM_PARMS" =~ -spice[[:space:]]+([^-]+) ]]; then
        eval "declare $(echo "${BASH_REMATCH[1]}" | tr ',' ' ')"
    fi
    SPICE_ADDR="${addr}:${port}"
fi

# Основной блок выполнения действий
case "$ACTION" in
    list)
        # Поиск PID процессов и объединение их через запятую для утилиты ps
        PIDS=$(pgrep -f "qemu-system-x86_64.*-name" | paste -sd ',' -)
        if [ -n "$PIDS" ]; then
            # Извлечение и склеивание имен ВМ в одну строку через пробел
            ps -p "$PIDS" -o args= | grep -Po '(?<=-name )[^\s\b]+' | paste -sd ' ' -
        fi
        ;;

    info)
        # Вывод очищенной и склеенной в одну строку конфигурации ВМ
        echo "$VM_PARMS" | paste -sd ' ' -
        ;;

    start)
        if ! pgrep -f "qemu-system-x86_64.*-name ${VM_NAME}\b" > /dev/null; then
            rm -f "/tmp/${VM_NAME}.sock"
            eval "qemu-system-x86_64 $(echo "$VM_PARMS" | paste -sd ' ' -)"
            sleep 1
        fi

        export NO_AT_BRIDGE=1
        if [ "$SPICE_ADDR" = ":" ]; then
            remote-viewer --hotkeys="release-cursor=shift+f12" "vnc://$VNC_ADDR" >/dev/null 2>&1 &
        else
            remote-viewer --hotkeys="release-cursor=shift+f12" "spice://$SPICE_ADDR" >/dev/null 2>&1 &
        fi
        ;;

    stop)
        if [ -S "/tmp/${VM_NAME}.sock" ]; then
            echo "system_powerdown" | socat - UNIX-CONNECT:/tmp/${VM_NAME}.sock >/dev/null
        else
            echo "Ошибка: Управляющий сокет для '${VM_NAME}' не найден." >&2
            exit 1
        fi
        ;;

    pause)
        if [ -S "/tmp/${VM_NAME}.sock" ]; then
            echo "Приостановка (пауза) виртуальной машины '${VM_NAME}'..."
            echo "stop" | socat - UNIX-CONNECT:/tmp/${VM_NAME}.sock >/dev/null
        else
            echo "Ошибка: Управляющий сокет для '${VM_NAME}' не найден." >&2
            exit 1
        fi
        ;;

    resume)
        if [ -S "/tmp/${VM_NAME}.sock" ]; then
            echo "Возобновление работы виртуальной машины '${VM_NAME}'..."
            echo "cont" | socat - UNIX-CONNECT:/tmp/${VM_NAME}.sock >/dev/null
        else
            echo "Ошибка: Управляющий сокет для '${VM_NAME}' не найден." >&2
            exit 1
        fi
        ;;

    kill)
        kill $(pgrep -f "qemu-system-x86_64.*-name ${VM_NAME}\b") 2>/dev/null
        ;;

    usb-attach)
        DISK_PATH="$3"
        if [ -z "$DISK_PATH" ] || [ ! -f "$DISK_PATH" ]; then
            echo "Ошибка: Образ USB-носителя не задан или не найден." >&2
            echo "Использование: $0 usb-attach <имя_машины> <путь_к_файлу.img>" >&2
            exit 1
        fi

        if [ -S "/tmp/${VM_NAME}.sock" ]; then
            # Поиск ID USB-контроллера в строке параметров
            USB_ID=$(echo "$VM_PARMS" | grep -Po '(?<=-device )[^\s]*usb[^\s]*(?<=id=)[^\s,]+|(?<=-device )[^\s]*xhci[^\s]*(?<=id=)[^\s,]+' | grep -Po '(?<=id=)[^, ]+' | head -n1)
            USB_BUS="${USB_ID:-usb}.0"

            # Генерация уникального ID для носителя
            DRIVE_ID="usb-flash-$(date +%s%N | cut -b1-13)"

            echo "Имитация подключения USB-носителя к контроллеру '$USB_BUS' машины '${VM_NAME}'..."

            # Регистрация файл-образа флешки
            echo "drive_add 0 file=${DISK_PATH},format=raw,if=none,id=${DRIVE_ID}" | socat - UNIX-CONNECT:/tmp/${VM_NAME}.sock >/dev/null
            sleep 0.5

            # Подключение флешки к шине
            echo "device_add usb-storage,bus=${USB_BUS},drive=${DRIVE_ID},id=${DRIVE_ID}-dev" | socat - UNIX-CONNECT:/tmp/${VM_NAME}.sock >/dev/null

            echo "USB-носитель успешно подключен."
        else
            echo "Ошибка: Машина '${VM_NAME}' не запущена или управляющий сокет не найден." >&2
            exit 1
        fi
        ;;

    usb-detach)
        if [ -S "/tmp/${VM_NAME}.sock" ]; then
            # Поиск уникального id подключенной флешки в дереве устройств QEMU
            DEVICE_ID=$(echo "info qtree" | socat - UNIX-CONNECT:/tmp/${VM_NAME}.sock 2>/dev/null | grep -Po 'id "usb-flash-[0-9]+-dev"' | head -n1 | cut -d'"' -f2)

            if [ -n "$DEVICE_ID" ]; then
                echo "Извлечение USB-носителя из машины '${VM_NAME}'..."
                echo "device_del $DEVICE_ID" | socat - UNIX-CONNECT:/tmp/${VM_NAME}.sock >/dev/null
                echo "USB-носитель успешно отключен."
            else
                echo "Ошибка: Активные имитируемые USB-носители не найдены в этой ВМ." >&2
                exit 1
            fi
        else
            echo "Ошибка: Машина '${VM_NAME}' не запущена или управляющий сокет не найден." >&2
            exit 1
        fi
        ;;

    *)
        echo "Ошибка: Неизвестное действие '$ACTION'." >&2
        echo "Использование: $0 <start|stop|kill> <имя_машины> или $0 list" >&2
        exit 1
        ;;
esac
