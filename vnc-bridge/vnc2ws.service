[Unit]
Description=VNC to WebSocket Bridge Proxy
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/srv/qemu
ExecStart=/srv/qemu/vnc2ws 0.0.0.0:8080 --tokens=/srv/qemu/tokens.conf --webroot=/usr/share/novnc
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vnc2ws

[Install]
WantedBy=multi-user.target
