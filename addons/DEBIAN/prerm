#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        echo "Остановка и отключение служб виртуального стенда перед удалением..."

        # Останавливаем и отключаем timemachine
        if systemctl is-active --quiet timemachine.service; then
            systemctl stop timemachine.service >/dev/null 2>&1 || true
        fi
        systemctl disable timemachine.service >/dev/null 2>&1 || true

        # Останавливаем и отключаем distrohub
        if systemctl is-active --quiet distrohub.service; then
            systemctl stop distrohub.service >/dev/null 2>&1 || true
        fi
        systemctl disable distrohub.service >/dev/null 2>&1 || true
    ;;

    upgrade|failed-upgrade)
        :
    ;;

    *)
        echo "prerm вызван с неизвестным аргументом \`$1'" >&2
        exit 1
    ;;
esac

exit 0