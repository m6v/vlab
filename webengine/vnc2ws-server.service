[Unit]
Description=vnc2ws-server: Web Console Server & API Manager
After=network.target

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/srv/qemu
ExecStart=/srv/qemu/vnc2ws-server.py 0.0.0.0:8081 --proxy-port=8080 --token-source=/srv/qemu/tokens.conf --webroot=/usr/share/novnc/
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vnc2ws-server

[Install]
WantedBy=multi-user.target
