[Unit]
Description=vnc2ws-bridge: VNC to WebSocket Gateway Proxy
After=network.target

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/srv/qemu
ExecStart=/srv/qemu/vnc2ws-bridge.py 0.0.0.0:8080 --token-source=/srv/qemu/tokens.conf
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vnc2ws-bridge

[Install]
WantedBy=multi-user.target
