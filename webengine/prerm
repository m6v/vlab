#!/bin/sh
set -e
case "$1" in
    purge|remove)
        echo "Отключение служб..."
        systemctl stop vnc2ws-bridge.service vnc2ws-server.service || true
        systemctl disable vnc2ws-bridge.service vnc2ws-server.service || true
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm вызван с неизвестным аргументом: \$1" >&2
        exit 1
        ;;
esac

exit 0
