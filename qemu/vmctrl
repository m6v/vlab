#!/bin/bash

CONFIG_DIR="/srv/qemu/config"
LOG_FILE="/tmp/vmctrl.log"

echo "$(date '+%Y-%m-%d %H:%M:%S') $0 $*" >> $LOG_FILE

if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Использование: $0 <start|stop> <имя_машины>" >&2
    exit 1
fi

ACTION="$1"
export VM_NAME="$2"
CONF_FILE="${CONFIG_DIR}/${VM_NAME}.conf"

if [ ! -f "$CONF_FILE" ]; then
    echo "Ошибка: Файл конфигурации не найден." >&2
    exit 1
fi

# Определение пользователя запустившего графический сеанс, чтобы скрипт работал при запуске от root
USER=$(ps aux | grep '[d]bus-daemon --session' | awk 'NR==1 {print $1}')
export HOME=/home/$USER

# Подготовка чистого конфига с раскрытыми переменными для парсинга и запуска
CLEAN_CONF=$(envsubst '$HOME,$VM_NAME' < "$CONF_FILE")

# Поиск подстроки -spice, взятие всего до ближайшего дефиса в круглые скобки (группу)
if [[ "$CLEAN_CONF" =~ -spice[[:space:]]+([^-]+) ]]; then
    eval "declare $(echo "${BASH_REMATCH[1]}" | tr ',' ' ')"
fi
# Адрес и порт сервера SPICE, задаваемого в конфиге
VNC_ADDR="${addr}:${port}"

case "$ACTION" in
    start)
        # Если процесс запущен, предупредить удаление управляющего сокета и повторный запуск
        if ! pgrep -f "qemu-system-x86_64.*-name ${VM_NAME}\b" > /dev/null; then
            rm -f "/tmp/${VM_NAME}.sock"
            # Склеивание строк конфига через пробел и запуск виртуальной машины
            eval "qemu-system-x86_64 $(echo "$CLEAN_CONF" | paste -sd ' ' -)"
            sleep 1
        fi

        # Отключение поиска шины доступности AT-SPI в D-Bus
        export NO_AT_BRIDGE=1
        remote-viewer "spice://$VNC_ADDR" >/dev/null 2>&1 &
        ;;

    stop)
        # Штатное выключение через отправку команды в управляющий сокет
        if [ -S "/tmp/${VM_NAME}.sock" ]; then
            echo "system_powerdown" | nc -N -U "/tmp/${VM_NAME}.sock" >/dev/null
        else
            echo "Ошибка: Управляющий сокет для '${VM_NAME}' не найден." >&2
            exit 1
        fi
        ;;

    kill)
        # Принудительное завершение процесса виртуальной машины
        kill $(pgrep -f "qemu-system-x86_64.*-name ${VM_NAME}\b")
        ;;
    *)
        echo "Ошибка: Неизвестное действие '$ACTION'." >&2
        exit 1
        ;;
esac
