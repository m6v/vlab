#!/usr/bin/env bash
set -euo pipefail

IMG_DIR="$HOME/.local/share/qemu/images"
SNAP_NAME="auto_$(date +%Y-%m-%d)"
KEEP_DAYS=14

[[ -d "$IMG_DIR" ]] || exit 0

shopt -s nullglob
IMAGES=("$IMG_DIR"/*.qcow2)
[[ ${#IMAGES[@]} -eq 0 ]] && exit 0

for img in "${IMAGES[@]}"; do
    # Проверяем, не заблокирован ли файл запущенным QEMU
    if ! qemu-img info "$img" >/dev/null 2>&1; then
        echo "Пропуск $img: диск заблокирован запущенным QEMU" >&2
        continue
    fi

    # Если снапшот за сегодня уже есть — переходим к следующему диску
    if qemu-img snapshot -l "$img" | awk '{print $2}' | grep -qx "$SNAP_NAME"; then
        continue
    fi

    # Создаем внутренний снапшот
    qemu-img snapshot -c "$SNAP_NAME" "$img"

    # Ротация: оставляем только последние KEEP_DAYS снапшотов
    OLD_SNAPS=$(qemu-img snapshot -l "$img" | awk '/auto_[0-9]{4}-[0-9]{2}-[0-9]{2}/ {print $2}' | sort | head -n -"$KEEP_DAYS")
    for old in $OLD_SNAPS; do
        qemu-img snapshot -d "$old" "$img"
    done
done
