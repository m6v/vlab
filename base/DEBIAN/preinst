#!/bin/sh
set -e

if [ "$1" = "install" ] || [ "$1" = "upgrade" ]; then
    echo "Проверка наличия обязательных образов виртуальных машин..."

    TARGET_DIR="/srv/qemu/images"
    MISSING_FILES=""

    # Список обязательных файлов
    REQUIRED_FILES="arm-ipc.qcow2 arm-o.qcow2 ipc-master.qcow2 ipc-slave.qcow2 rubicon.qcow2"

    for file in $REQUIRED_FILES; do
        if [ ! -f "$TARGET_DIR/$file" ]; then
            MISSING_FILES="$MISSING_FILES $file"
        fi
    done

    # Если список пропущенных файлов не пуст, прерываем установку
    if [ -n "$MISSING_FILES" ]; then
        printf "\033[0;31mОшибка. В каталоге $TARGET_DIR отсутствуют файлы:" >&2
        for missing in $MISSING_FILES; do
            printf " $missing" >&2
        done
        echo
        printf "Установка среды виртуализации УТК-СЗИ прервана.\033[0m\n" >&2
        exit 1
    fi
fi

exit 0
