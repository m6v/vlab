#!/bin/bash

CONFIG_DIR="/srv/qemu/config"
SELF_NAME=$(basename "${BASH_SOURCE[0]}")

# Перенаправление stderr скрипта в logger
exec 2> >(logger -t $SELF_NAME -p user.err)

# Определение имени пользователя, сидящего за монитором (seat0)
export SEAT_USER=$(loginctl show-session $(loginctl show-seat seat0 -p ActiveSession --value) -p Name --value)

# Аварийный выход, если на seat0 нет активной сессии
if [ -z "$SEAT_USER" ]; then
    echo "Ошибка: Запуск прерван: на seat0 нет активной сессии" | tee /dev/stderr
    exit 1
fi

# Переключение на пользователя, только если скрипт запущен не под ним (защита от бесконечной рекурсии)
if [ "$(whoami)" != "$SEAT_USER" ]; then
    export USER="$SEAT_USER"
    export HOME=$(getent passwd "$USER" | cut -d ':' -f 6)
    exec sudo -u "$USER" HOME="$HOME" USER="$USER" "$0" "$@"
fi

ACTION="$1"

# Вывод имен запущенных виртуальных машин
if [ "$ACTION" = "list" ]; then
    # Поиск PID процессов и объединение их через запятую для утилиты ps
    PIDS=$(pgrep -f "qemu-system-x86_64.*-name" | paste -sd ',' -)
    if [ -n "$PIDS" ]; then
        # Извлечение и склеивание имен виртуальных машин в одну строку через пробел
        ps -p "$PIDS" -o args= | grep -Po '(?<=-name )[^\s\b]+' | paste -sd ' ' -
        exit 0
    fi
    exit 1
fi

# Проверка наличия по крайней мере еще одного аргумента (имени виртуальной машины)
if [ -z "$2" ]; then
    echo "Ошибка: Не указано имя виртуальной машины." | tee /dev/stderr
    echo "Использование: $SELF_NAME <list|info|start|stop|resume|reset|powerdown|quit|kill> <имя_машины> или $SELF_NAME list"
    echo "Синтаксис команд управления см. на https://www.qemu.org/docs/master/system/monitor.html"
    exit 1
fi

# Последний аргумент всегда имя виртуальной машины с опциональным адресом, например, arm@192.168.1.1
TARGET="${@:$#}"
export VM_NAME="${TARGET%%@*}"
VM_HOST="${TARGET#*@}"
[[ "$VM_HOST" == "$TARGET" || -z "$VM_HOST" ]] && VM_HOST="127.0.0.1"

# Пул с образами виртуальных машин, USB-дисков и т.п.
USER_POOL="$HOME/.local/share/qemu/images"

# Проверка наличия файла конфигурации
CONF_FILE="${CONFIG_DIR}/${VM_NAME}.conf"
if [ ! -f "$CONF_FILE" ]; then
    echo "Ошибка: Файл конфигурации для '${VM_NAME}' не найден." | tee /dev/stderr
    exit 1
fi

# Подготовка аргументов для qemu-system на основе конфигурационного файла
VM_PARMS=$(envsubst '$USER,$HOME,$VM_NAME' < "$CONF_FILE")

# Определение номера адреса VNC с учетом базы 5900 и номера дисплея
VNC_DISPLAY=$(echo "$VM_PARMS" | grep -Po '(?<=-vnc)\s+[^:\s]*:\K[0-9]+' || echo 0)
VNC_PORT=$(( VNC_DISPLAY < 5900 ? 5900 + VNC_DISPLAY : VNC_DISPLAY ))
VNC_ADDR="$VM_HOST:$VNC_PORT"

# Поиск подстроки -spice и взятие всего до ближайшего дефиса в круглые скобки
if [[ "$VM_PARMS" =~ -spice[[:space:]]+([^-]+) ]]; then
    eval "declare $(echo "${BASH_REMATCH[1]}" | tr ',' ' ')"
fi
SPICE_ADDR="${addr}:${port}"

# Определение управляющего сокета
VM_MONITOR=$(echo $VM_PARMS | grep -oP -- '-monitor \K[^,]*')
if [[ "$VM_MONITOR" =~ "unix:" ]]; then
    VM_SOCK_FILE=$(echo "$VM_MONITOR" | cut -d: -f2)
    VM_SOCK_DIR=$(dirname $VM_SOCK_FILE)
    # Создание каталога для управляющего сокета
    mkdir -p $VM_SOCK_DIR
    chmod 700 $VM_SOCK_DIR
    VM_SOCK=UNIX-CONNECT:$VM_SOCK_FILE
elif [[ "$VM_MONITOR" =~ "tcp:" ]]; then
    VM_SOCK_PORT=$(echo "$VM_MONITOR" | cut -d: -f3)
    VM_SOCK=TCP:$VM_HOST:$VM_SOCK_PORT
else
    echo "Ошибка: Управляющий сокет для '${VM_NAME}' не найден." | tee /dev/stderr
    exit 1
fi

if [ "$ACTION" = "start" ]; then
    # Запуск VM_NAME, если не запущена
    if ! pgrep -f "qemu-system-x86_64.*-name ${VM_NAME}\b" > /dev/null; then
        eval "qemu-system-x86_64 $(echo "$VM_PARMS" | paste -sd ' ' -)"
        sleep 1
    fi

    # Запуск десктопного клиента spice, если адрес spice задан и скрипт запущен пользователем
    if [ "$SPICE_ADDR" != ":" ] && [ -n "$DISPLAY" ]; then
        remote-viewer --hotkeys="release-cursor=shift+f12" "spice://$SPICE_ADDR" >/dev/null 2>&1 &
    fi

    exit 0
fi

if [ "$ACTION" = "kill" ]; then
    # Принудительное завершение процесса, если quit не помогла
    kill $(pgrep -f "qemu-system-x86_64.*-name ${VM_NAME}\b") 2>/dev/null
    exit $?
fi

# Синонимы команд
[ "$ACTION" = "pause" ] && ACTION="stop"
[ "$ACTION" = "resume" ] && ACTION="cont"
[ "$ACTION" = "reset" ] && ACTION="system_reset"
[ "$ACTION" = "powerdown" ] && ACTION="system_powerdown"

# Основной блок выполнения действий
case "$ACTION" in
    usb-attach)
        DISK_NAME="$2"
        # Если полный путь не задан, используем образ в пользовательском пуле
        [ "$(dirname "$DISK_NAME")" = "." ] && DISK_PATH="${USER_POOL}/${DISK_NAME}" || DISK_PATH="$DISK_NAME"

        if [ ! -f "$DISK_PATH" ]; then
            echo "Ошибка: Образ USB-носителя не задан или не найден." | tee /dev/stderr
            echo "Использование: $SELF_NAME usb-attach <путь_к_файлу.img> <имя_машины>"
            exit 1
        fi
        DISK_ID=id$(echo -n "$DISK_PATH" | md5sum | cut -c 1-8)
        # Регистрация USB-носителя на хосте 
        echo "drive_add 0 if=none,id=${DISK_ID},file=${DISK_PATH},format=raw" | socat - "$VM_SOCK"  # >/dev/null
        sleep 1
        # Подключение USB-носителя к шине usb3.0
        echo "device_add usb-storage,drive=${DISK_ID},id=${DISK_ID},bus=usb3.0" | socat - "$VM_SOCK"  # >/dev/null
        echo "USB-носитель успешно подключен."
        ;;

    usb-detach)
        DISK_NAME="$2"
        # Если полный путь не задан, используем образ в пользовательском пуле
        [ "$(dirname "$DISK_NAME")" = "." ] && DISK_PATH="${USER_POOL}/${DISK_NAME}" || DISK_PATH="$DISK_NAME"

        if [ ! -f "$DISK_PATH" ]; then
            echo "Ошибка: Образ USB-носителя не задан или не найден." | tee /dev/stderr
            echo "Использование: $SELF_NAME usb-detach <путь_к_файлу.img> <имя_машины>"
            exit 1
        fi
        DISK_ID=id$(echo -n "$DISK_PATH" | md5sum | cut -c 1-8)
        # Отключение USB-носителя от шины usb3.0
        echo "device_del ${DISK_ID}" | socat - "$VM_SOCK"
        sleep 1
        # Анулирование регистрация USB-носителя на хосте
        echo "drive_del ${DISK_ID}" | socat - "$VM_SOCK"
        exit 0
        ;;

    *)
        # Аргументы со второго по предпоследний (первый это $ACTION, последний это $VM_NAME, который в команде не используется)
        # Синтаксис должен соответствовать протоколу HMP (Human Monitor Interface) [https://www.qemu.org/docs/master/system/monitor.html]
        EXTRA_ARGS="${@:2:$#-2}"
        echo "$ACTION $EXTRA_ARGS" | socat - "$VM_SOCK" | grep -Ev "^\(qemu\)|^QEMU"
        ;;
esac
