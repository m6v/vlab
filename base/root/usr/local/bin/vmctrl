#!/bin/bash

CONFIG_DIR="/srv/qemu/config"
LOG_FILE="/srv/qemu/vmctrl.log"

# Определение имени пользователя, сидящего за монитором (seat0)
export SEAT_USER=$(loginctl show-session $(loginctl show-seat seat0 -p ActiveSession --value) -p Name --value)

# Аварийный выход, если на seat0 нет активной сессии
if [ -z "$SEAT_USER" ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') $(hostname) [Error] Запуск прерван: на seat0 нет активной сессии" >> $LOG_FILE
    exit 1
fi

# Переключение на пользователя, только если мы еще не под ним (защита от бесконечной рекурсии)
if [ "$(whoami)" != "$SEAT_USER" ]; then
    export USER="$SEAT_USER"
    export HOME="/home/$USER"
    exec sudo -u "$USER" HOME="$HOME" USER="$USER" "$0" "$@"
fi

# Логирование исполняемой команды
echo "$(date '+%Y-%m-%d %H:%M:%S') $(hostname) [Info] seat0:$USER $0 $*" >> $LOG_FILE

ACTION="$1"

if [ "$ACTION" = "list" ]; then
    # Поиск PID процессов и объединение их через запятую для утилиты ps
    PIDS=$(pgrep -f "qemu-system-x86_64.*-name" | paste -sd ',' -)
    if [ -n "$PIDS" ]; then
        # Извлечение и склеивание имен ВМ в одну строку через пробел
        ps -p "$PIDS" -o args= | grep -Po '(?<=-name )[^\s\b]+' | paste -sd ' ' -
        exit 0
    fi
    exit 1
fi

# Проверка наличия по крайней мере еще одного аргумента (имени ВМ)
if [ -z "$2" ]; then
    echo "Ошибка: Не указано имя виртуальной машины." >&2
    echo "Использование: $0 <list|info|start|stop|resume|reset|powerdown|quit|kill> <имя_машины> или $0 list" >&2
    exit 1
fi

# Последний аргумент всегда имя ВМ, выполняем его экспорт, так как испольуем в envsubst
export VM_NAME="${@:$#}"

# Каталог для управляющего сокета ВМ
mkdir -p /tmp/qemu/$USER
chmod 700 /tmp/qemu/$USER
# Управляющий сокет ВМ
VM_SOCK=/tmp/qemu/$USER/$VM_NAME.sock
# Пул с образами виртуальных машин, USB-дисков и т.п.
USER_POOL="/home/$USER/.local/share/qemu/images"

if [ "$ACTION" = "start" ]; then
    CONF_FILE="${CONFIG_DIR}/${VM_NAME}.conf"

    # Проверка наличия файла конфигурации
    if [ ! -f "$CONF_FILE" ]; then
        echo "Ошибка: Файл конфигурации для '${VM_NAME}' не найден." >&2
        exit 1
    fi

    # Выполняем экспорт, так как испольуем переменную в envsubst
    export HOME=/home/$USER

    # Подготовка аргументов для qemu-system на основе конфигурационного файла
    VM_PARMS=$(envsubst '$USER,$HOME,$VM_NAME' < "$CONF_FILE")

    # Определение номера порта с учетом базы 5900 и номера дисплея
    VNC_ADDR="127.0.0.1:$((5900 + $(echo "$VM_PARMS" | grep -Po '(?<=-vnc 0.0.0.0:)[0-9]+' || echo 0)))"

    # Поиск подстроки -spice и взятие всего до ближайшего дефиса в круглые скобки
    if [[ "$VM_PARMS" =~ -spice[[:space:]]+([^-]+) ]]; then
        eval "declare $(echo "${BASH_REMATCH[1]}" | tr ',' ' ')"
    fi
    SPICE_ADDR="${addr}:${port}"

    # Запуск VM_NAME, если не запущена
    if ! pgrep -f "qemu-system-x86_64.*-name ${VM_NAME}\b" > /dev/null; then
        # Удаление управляющего сокета, если остался после некорректной остановки
        [ -S "$VM_SOCK" ] && rm -f "$VM_SOCK"
        eval "qemu-system-x86_64 $(echo "$VM_PARMS" | paste -sd ' ' -)"
        sleep 1
    fi

    # Запуск десктопного клиента spice, если адрес spice задан и скрипт запущен пользователем
    if [ "$SPICE_ADDR" != ":" ] && [ -n "$DISPLAY" ]; then
        remote-viewer --hotkeys="release-cursor=shift+f12" "spice://$SPICE_ADDR" >/dev/null 2>&1 &
    fi

    exit 0
fi

if [ "$ACTION" = "kill" ]; then
    # Принудительное завершение процесса, если quit не помогла
    kill $(pgrep -f "qemu-system-x86_64.*-name ${VM_NAME}\b") 2>/dev/null
    exit $?
fi

if [ ! -S "$VM_SOCK" ]; then
    echo "Ошибка: Управляющий сокет для '${VM_NAME}' не найден." >&2
    exit 1
fi

# Синонимы команд
[ "$ACTION" = "pause" ] && ACTION="stop"
[ "$ACTION" = "resume" ] && ACTION="cont"
[ "$ACTION" = "reset" ] && ACTION="system_reset"
[ "$ACTION" = "powerdown" ] && ACTION="system_powerdown"

# Основной блок выполнения действий
case "$ACTION" in
    usb-attach)
        DISK_NAME="$2"
        # Если полный путь не задан, используем образ в пользовательском пуле
        [ "$(dirname "$DISK_NAME")" = "." ] && DISK_PATH="${USER_POOL}/${DISK_NAME}" || DISK_PATH="$DISK_NAME"

        if [ ! -f "$DISK_PATH" ]; then
            echo "Ошибка: Образ USB-носителя не задан или не найден." >&2
            echo "Использование: $0 usb-attach <путь_к_файлу.img> <имя_машины>" >&2
            exit 1
        fi
        DISK_ID=id$(echo -n "$DISK_PATH" | md5sum | cut -c 1-8)
        # Регистрация
        echo "drive_add 0 if=none,id=${DISK_ID},file=${DISK_PATH},format=raw" | socat - UNIX-CONNECT:"$VM_SOCK"  # >/dev/null
        sleep 0.5
        # Подключение USB-носителя к шине
        echo "device_add usb-storage,drive=${DISK_ID},id=${DISK_ID},bus=usb3.0" | socat - UNIX-CONNECT:"$VM_SOCK"  # >/dev/null

        echo "USB-носитель успешно подключен."
        ;;

    usb-detach)
        DISK_NAME="$2"
        # Если полный путь не задан, используем образ в пользовательском пуле
        [ "$(dirname "$DISK_NAME")" = "." ] && DISK_PATH="${USER_POOL}/${DISK_NAME}" || DISK_PATH="$DISK_NAME"

        if [ ! -f "$DISK_PATH" ]; then
            echo "Ошибка: Образ USB-носителя не задан или не найден." >&2
            echo "Использование: $0 usb-detach <путь_к_файлу.img> <имя_машины>" >&2
            exit 1
        fi
        DISK_ID=id$(echo -n "$DISK_PATH" | md5sum | cut -c 1-8)
        echo "device_del ${DISK_ID}" | socat - UNIX-CONNECT:"$VM_SOCK"
        echo "drive_del ${DISK_ID}" | socat - UNIX-CONNECT:"$VM_SOCK"
        exit 0
        ;;

    *)
        # Аргументы со второго по предпоследний (первый это $ACTION, последний это $VM_NAME, который в команде не используется)
        EXTRA_ARGS="${@:2:$#-2}"
        echo "$ACTION $EXTRA_ARGS" | socat - UNIX-CONNECT:"$VM_SOCK" | grep -Ev "^\(qemu\)|^QEMU"
        ;;
esac
